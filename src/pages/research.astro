---
import BaseLayout from '@layouts/BaseLayout.astro';
import ResearchTop from '@components/ResearchTopic.astro';

import { getCollection } from 'astro:content';

const researchCollection = await getCollection('research');

const pageTitle = 'Research Page';
---

<BaseLayout pageTitle={pageTitle}>
  <p>Welcome to the research page, styled by Tailwind CSS!</p>
  <ul>
    {researchCollection.map((topic) => (
      <ResearchTop url={`${import.meta.env.BASE_URL}/research-topics/${topic.id}`} title={topic.data.title} />
    ))}
  </ul>
</BaseLayout>