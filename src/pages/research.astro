---
import BaseLayout from '@layouts/BaseLayout.astro';
import ResearchTopic from '@components/ResearchTopic.astro';

import { getCollection } from 'astro:content';

const researchCollection = await getCollection('research');

const pageTitle = 'Research Page';
---

<BaseLayout pageTitle={pageTitle}>
  <p>Active Research Projects</p>
  <ul>
    {researchCollection.map((topic) => (
      <ResearchTopic url={`${import.meta.env.BASE_URL}/research-topics/${topic.id}`} title={topic.data.title} />
    ))}
  </ul>
</BaseLayout>